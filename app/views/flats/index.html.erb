<div class="container">
  <h1>All our flats</h1>
  <div class="cards">
    <% @flats.each do |flat| %>
    <div class="card">
      <h5 class="card-header"><%= flat.name %></h5>
      <div class="card-body">
        <h5 class="card-title"> Price per night -> <%= flat.price_per_night %>€</h5>
        <h6 class="card-text">Numbers of guests for the flat -> <%= flat.number_of_guests %></h6>
        <br>
        <div>
          <%= link_to "More info", flat_path(flat), class: "btn btn-outline-info"%>
          <%= link_to "Edit", edit_flat_path(flat), class: "btn btn-outline-warning"%>
          <%= link_to "Delete", flat_path(flat),class: "btn btn-outline-danger", data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}%>
        </div>
      </div>
    </div>
    <% end %>
  </div>
</div>
